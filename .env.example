# ---------------------------------------------------------------
# Copy to .env (`make env` / `cp .env.example .env`) and adjust.
# ---------------------------------------------------------------

# --- Application ---------------------------------------------------
# Application environment: prod | dev | test
APP_ENV=prod
# Host port where the whole app (Angular SPA + /api + /uploads) is served by nginx
HTTP_PORT=8080
# Allowed CORS origin for the API (useful when running `ng serve` separately)
CORS_ALLOW_ORIGIN=*

# --- PostgreSQL ----------------------------------------------------
POSTGRES_DB=products
POSTGRES_USER=app
POSTGRES_PASSWORD=app_secret
# Host port to expose PostgreSQL on (for local DB clients)
DB_PORT=5432

# --- RabbitMQ (Symfony Messenger transport) ------------------------
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app_secret
# Host port of the RabbitMQ management UI
RABBITMQ_UI_PORT=15672

# --- Authentication (JWT) ------------------------------------------
# HMAC secret used to sign JWT tokens (min. 32 chars)
JWT_SECRET=change-me-to-a-long-random-string-0123456789
# Token lifetime in seconds
JWT_TTL=3600
# Single administrator account used on the login page.
# The password is stored as a bcrypt hash (default password: admin123).
# Generate a new one: `make password-hash PASSWORD=...`. Keep the single quotes: the hash contains "$".
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH='$2y$12$J3Z2Xp6mpgVxX0xTkYWJjOoMagiGu2l0Ms87DhOThWrR//enJq2qy'

# --- Import --------------------------------------------------------
# Max upload size in bytes (default 10 MB)
IMPORT_MAX_FILE_SIZE=10485760
# Rate limit for POST /api/imports: N requests per interval per user
IMPORT_RATE_LIMIT=5
IMPORT_RATE_INTERVAL="1 minute"
# Timeout (seconds) for downloading a single product image
IMAGE_DOWNLOAD_TIMEOUT=15
