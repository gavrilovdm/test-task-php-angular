{
    "name": "test-task/products-import",
    "description": "Products import/export API (Slim 4 + Doctrine ORM + Symfony Messenger)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-amqp": "*",
        "ext-fileinfo": "*",
        "ext-pdo_pgsql": "*",
        "doctrine/data-fixtures": "^2.0",
        "doctrine/dbal": "^4.2",
        "doctrine/migrations": "^3.8",
        "doctrine/orm": "^3.3",
        "firebase/php-jwt": "^7.0",
        "guzzlehttp/guzzle": "^7.9",
        "php-di/php-di": "^7.0",
        "phpoffice/phpspreadsheet": "^3.9",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "symfony/amqp-messenger": "^7.2",
        "symfony/cache": "^7.2",
        "symfony/console": "^7.2",
        "symfony/event-dispatcher": "^7.2",
        "symfony/messenger": "^7.2",
        "symfony/rate-limiter": "^7.2",
        "symfony/uid": "^7.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    }
}
